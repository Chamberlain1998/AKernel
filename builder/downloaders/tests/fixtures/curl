#!/usr/bin/env bash

set -euo pipefail

destination=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -o)
      destination="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

[[ -n "${destination}" ]]
mkdir -p "${FAKE_CURL_CALL_DIR}"
: >"${FAKE_CURL_CALL_DIR}/call-$$-${RANDOM}"
if [[ -n "${FAKE_CURL_DELAY:-}" ]]; then
  sleep "${FAKE_CURL_DELAY}"
fi
if [[ "${FAKE_CURL_FAIL:-0}" == "1" ]]; then
  printf 'partial\n' >"${destination}"
  exit 28
fi
cp "${FAKE_CURL_SOURCE}" "${destination}"
